@model LibraryApplication.Models.Book
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Add Book</h2>

<form asp-action="AddBook" method="post">
    <div>
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control"/>
    </div>
    <div>
        <label asp-for="Author" class="control-label"></label>
        <input asp-for="Author" class="form-control"/>
    </div>
    <div>
        <label asp-for="Genre" class="control-label"></label>
        <input asp-for="Genre" class="form-control"/>
    </div>
    <div>
        <label asp-for="CoverImageUrl" class="control-label"></label>
        <input asp-for="CoverImageUrl" class="form-control"/>
    </div>
    <div>
        <label asp-for="TotalCopies" class="control-label"></label>
        <input asp-for="TotalCopies" class="form-control"/>
    </div>
    <div>
        <input type="hidden" name="libraryId" value="@ViewBag.LibraryId">
        <input type="submit" value="Add" class="btn btn-primary"/>
    </div>
</form>
